{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldab3awy",
  "main": "worker.js",
  "compatibility_date": "2026-10-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-cafe-pos-db",
      "database_id": "REPLACE_WITH_YOUR_NEW_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
